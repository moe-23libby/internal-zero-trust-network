<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        Zero Trust Security Center
    </title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='dashboard.css') }}"
    >

</head>

<body>

<div class="sidebar">

    <div class="logo">
        ZTNA
    </div>

    <h2>
        Security Center
    </h2>

    <a
        href="/"
        class="{{ 'active' if page == 'overview' else '' }}"
    >
        Overview
    </a>

    <a
        href="/access"
        class="{{ 'active' if page == 'access' else '' }}"
    >
        Access
    </a>

    <a
        href="/devices"
        class="{{ 'active' if page == 'devices' else '' }}"
    >
        Devices
    </a>

    <a
        href="/threats"
        class="{{ 'active' if page == 'threats' else '' }}"
    >
        Threats
    </a>

    <a
        href="/incidents"
        class="{{ 'active' if page == 'incidents' else '' }}"
    >
        Incidents
    </a>

    <a
        href="/admin"
        class="{{ 'active' if page == 'admin' else '' }}"
    >
        Admin
    </a>

</div>


<div class="main">

<header>

    <div>

        <h1>
            Zero Trust Security Center
        </h1>

        <p>
            Continuous identity, trust and threat monitoring
        </p>

    </div>

    <div class="live">
        ● LIVE
    </div>

</header>


{% with messages = get_flashed_messages() %}

    {% if messages %}

        {% for message in messages %}

            <div class="flash">
                {{ message }}
            </div>

        {% endfor %}

    {% endif %}

{% endwith %}


{% if page == "overview" %}

<div class="cards">

    <div class="card">
        <span>Trusted Devices</span>
        <strong>{{ trusted_devices }}</strong>
    </div>

    <div class="card">
        <span>Active Sessions</span>
        <strong>{{ active_sessions }}</strong>
    </div>

    <div class="card">
        <span>Attacks Today</span>
        <strong>{{ attacks_today }}</strong>
    </div>

    <div class="card warning-card">
        <span>Open Security Alerts</span>
        <strong>{{ open_alerts }}</strong>
    </div>

    <div class="card danger-card">
        <span>Locked Accounts</span>
        <strong>{{ locked_accounts }}</strong>
    </div>

</div>

<section>

<h2>
    Current Access Decisions
</h2>

<div class="table-wrap">

<table>

<thead>

<tr>

    <th>User</th>
    <th>Role</th>
    <th>Device</th>
    <th>Trust</th>
    <th>Risk</th>
    <th>Decision</th>
    <th>Reason</th>

</tr>

</thead>


<tbody>

{% for row in access_states %}

<tr>

    <td>
        {{ row.username }}
    </td>

    <td>
        {{ row.role }}
    </td>

    <td>
        {{ row.device_name or "-" }}
    </td>

    <td>

        <strong>
            {{ row.trust_score }}
        </strong>

    </td>

    <td>
        {{ row.risk_score }}
    </td>

    <td>

        {% if row.quarantine_status %}

            <span class="badge quarantine">
                🔒 QUARANTINED
            </span>

        {% elif row.decision == "ALLOW" %}

            <span class="badge allow">
                ● ALLOW
            </span>

        {% elif row.decision == "STEP_UP" %}

            <span class="badge stepup">
                ● STEP-UP MFA
            </span>

        {% elif row.decision == "LIMITED" %}

            <span class="badge limited">
                ● LIMITED
            </span>

        {% else %}

            <span class="badge block">
                ● BLOCK
            </span>

        {% endif %}

    </td>

    <td>
        {{ row.reason or "-" }}
    </td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</section>


<section>

<h2>
    Active / Latest Incident
</h2>


{% if latest_attack %}

<div class="incident">

    <div>

        <label>
            Attack
        </label>

        <strong>
            {{ latest_attack.attack_type }}
        </strong>

    </div>


    <div>

        <label>
            Source
        </label>

        <strong>
            {{ latest_attack.source_ip }}
        </strong>

    </div>


    <div>

        <label>
            Target
        </label>

        <strong>
            {{ latest_attack.destination_ip }}
        </strong>

    </div>


    <div>

        <label>
            Severity
        </label>

        <strong>
            {{ latest_attack.threat_level }}
        </strong>

    </div>


    <div>

        <label>
            MITRE
        </label>

        <strong>
            {{ latest_attack.mitre_id or "-" }}
        </strong>

    </div>


    <div>

        <label>
            Technique
        </label>

        <strong>
            {{ latest_attack.mitre_technique or "-" }}
        </strong>

    </div>

</div>

{% else %}

<p>
    No security incidents have been recorded.
</p>

{% endif %}

</section>


<section>

<h2>
    Recent Threats
</h2>

<div class="table-wrap">

<table>

<thead>

<tr>

    <th>Time</th>
    <th>Attack</th>
    <th>Source</th>
    <th>Target</th>
    <th>Protocol</th>
    <th>Risk</th>
    <th>Severity</th>

</tr>

</thead>

<tbody>

{% for attack in recent_attacks %}

<tr>

    <td>
        {{ attack.timestamp }}
    </td>

    <td>
        {{ attack.attack_type }}
    </td>

    <td>
        {{ attack.source_ip }}
    </td>

    <td>
        {{ attack.destination_ip }}
    </td>

    <td>
        {{ attack.protocol }}
    </td>

    <td>
        {{ attack.risk_score }}
    </td>

    <td>
        {{ attack.threat_level }}
    </td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</section>


<section>

<h2>
    Incident Timeline
</h2>

<div class="timeline">

{% for event in timeline %}

<div class="timeline-event">

    <div class="timeline-time">
        {{ event.timestamp }}
    </div>

    <div>

        <strong>
            {{ event.event_type }}
        </strong>

        <p>
            {{ event.description }}
        </p>

        <small>
            {{ event.username or "Unknown" }}
            {% if event.source_ip %}
                • {{ event.source_ip }}
            {% endif %}
        </small>

    </div>

</div>

{% endfor %}

</div>

</section>

{% endif %}



{% if page == "access" %}

<section>

<h2>
    Access Policy State
</h2>

<div class="table-wrap">

<table>

<thead>

<tr>
    <th>User</th>
    <th>Role</th>
    <th>Device</th>
    <th>Trust</th>
    <th>Risk</th>
    <th>Decision</th>
    <th>Step-Up</th>
    <th>Quarantine</th>
    <th>Reason</th>
</tr>

</thead>

<tbody>

{% for row in access_states %}

<tr>

    <td>{{ row.username }}</td>
    <td>{{ row.role }}</td>
    <td>{{ row.device_name }}</td>
    <td>{{ row.trust_score }}</td>
    <td>{{ row.risk_score }}</td>

    <td>
        {{ row.decision }}
    </td>

    <td>
        {{ "YES" if row.step_up_required else "NO" }}
    </td>

    <td>
        {{ "YES" if row.quarantine_status else "NO" }}
    </td>

    <td>
        {{ row.reason }}
    </td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</section>

{% endif %}



{% if page == "devices" %}

<section>

<h2>
    Device Certificates
</h2>

<div class="table-wrap">

<table>

<thead>

<tr>
    <th>User</th>
    <th>Device</th>
    <th>Certificate CN</th>
    <th>Serial</th>
    <th>Status</th>
    <th>Created</th>
    <th>Revoked</th>
</tr>

</thead>


<tbody>

{% for cert in certificates %}

<tr>

    <td>{{ cert.username }}</td>

    <td>
        {{ cert.device_name }}
    </td>

    <td>
        {{ cert.certificate_cn }}
    </td>

    <td class="serial">
        {{ cert.certificate_serial }}
    </td>

    <td>

        {% if cert.status == "ACTIVE" %}

            <span class="badge allow">
                ACTIVE
            </span>

        {% else %}

            <span class="badge block">
                {{ cert.status }}
            </span>

        {% endif %}

    </td>

    <td>
        {{ cert.created_at }}
    </td>

    <td>
        {{ cert.revoked_at or "-" }}
    </td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</section>

{% endif %}



{% if page == "threats" %}

<section>

<h2>
    Threat Detection
</h2>

<div class="table-wrap">

<table>

<thead>

<tr>

    <th>Time</th>
    <th>Attack</th>
    <th>Source</th>
    <th>Target</th>
    <th>Protocol</th>
    <th>Risk</th>
    <th>Threat</th>
    <th>MITRE</th>
    <th>Technique</th>

</tr>

</thead>

<tbody>

{% for attack in attacks %}

<tr>

    <td>{{ attack.timestamp }}</td>
    <td>{{ attack.attack_type }}</td>
    <td>{{ attack.source_ip }}</td>
    <td>{{ attack.destination_ip }}</td>
    <td>{{ attack.protocol }}</td>
    <td>{{ attack.risk_score }}</td>
<td>

    {% if attack.threat_level == "Critical" %}

        <span class="severity severity-critical">
            CRITICAL
        </span>

    {% elif attack.threat_level == "High" %}

        <span class="severity severity-high">
            HIGH
        </span>

    {% elif attack.threat_level == "Medium" %}

        <span class="severity severity-medium">
            MEDIUM
        </span>

    {% else %}

        <span class="severity severity-low">
            {{ attack.threat_level }}
        </span>

    {% endif %}

</td>
    <td>{{ attack.mitre_id or "-" }}</td>
    <td>{{ attack.mitre_technique or "-" }}</td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</section>

{% endif %}



{% if page == "incidents" %}

<section>

<h2>
    Incident Timeline
</h2>

<div class="timeline">

{% for event in timeline %}

<div class="timeline-event">

    <div class="timeline-time">
        {{ event.timestamp }}
    </div>

    <div>

        <strong>
            {{ event.event_type }}
        </strong>

        <p>
            {{ event.description }}
        </p>

        <small>
            User: {{ event.username or "-" }}
            |
            Source: {{ event.source_ip or "-" }}
            |
            Severity: {{ event.severity }}
        </small>

    </div>

</div>

{% endfor %}

</div>

</section>


<section>

<h2>
    Enforcement History
</h2>

<div class="table-wrap">

<table>

<thead>

<tr>
    <th>Time</th>
    <th>Device</th>
    <th>Action</th>
    <th>Target</th>
    <th>Port</th>
    <th>Reason</th>
</tr>

</thead>

<tbody>

{% for item in enforcement %}

<tr>

    <td>{{ item.timestamp }}</td>
    <td>{{ item.device_ip }}</td>
    <td>{{ item.action }}</td>
    <td>{{ item.destination_ip }}</td>
    <td>{{ item.destination_port }}</td>
    <td>{{ item.reason }}</td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</section>

{% endif %}



{% if page == "admin" %}

<section>

<h2>
    Administrator Security Actions
</h2>

<p>
    Logged in as:
    <strong>
        {{ admin_user.username }}
    </strong>
</p>

</section>


<section>

<h2>
    Active Sessions
</h2>

<div class="table-wrap">

<table>

<thead>

<tr>
    <th>User</th>
    <th>Device IP</th>
    <th>Status</th>
    <th>Created</th>
    <th>Revoked</th>
    <th>Action</th>
</tr>

</thead>

<tbody>

{% for session in sessions %}

<tr>

    <td>{{ session.username }}</td>
    <td>{{ session.device_ip }}</td>
    <td>{{ session.status }}</td>
    <td>{{ session.created_at }}</td>
    <td>{{ session.revoked_at or "-" }}</td>

    <td>

        {% if session.status == "ACTIVE" %}

        <form
            method="POST"
            action="/admin/revoke-session/{{ session.id }}"
        >

            <button class="btn-danger">
                Revoke Session
            </button>

        </form>

        {% else %}

            -

        {% endif %}

    </td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</section>



<section>

<h2>
    Device Certificates
</h2>

<div class="table-wrap">

<table>

<thead>

<tr>
    <th>User</th>
    <th>Device</th>
    <th>Status</th>
    <th>Action</th>
</tr>

</thead>

<tbody>

{% for cert in certificates %}

<tr>

    <td>{{ cert.username }}</td>
    <td>{{ cert.device_name }}</td>
    <td>{{ cert.status }}</td>

    <td>

        {% if cert.status == "ACTIVE" %}

        <form
            method="POST"
            action="/admin/revoke-certificate/{{ cert.id }}"
        >

            <button class="btn-danger">
                Revoke Certificate
            </button>

        </form>

        {% else %}

        -

        {% endif %}

    </td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</section>



<section>

<h2>
    Quarantined Devices
</h2>

<div class="table-wrap">

<table>

<thead>

<tr>
    <th>User</th>
    <th>Source IP</th>
    <th>Reason</th>
    <th>Severity</th>
    <th>Status</th>
    <th>Started</th>
    <th>Action</th>
</tr>

</thead>

<tbody>

{% for item in quarantines %}

<tr>

    <td>{{ item.username }}</td>
    <td>{{ item.source_ip }}</td>
    <td>{{ item.reason }}</td>
    <td>{{ item.severity }}</td>
    <td>{{ item.status }}</td>
    <td>{{ item.started_at }}</td>

    <td>

        {% if item.status == "ACTIVE" %}

        <form
            method="POST"
            action="/admin/release-quarantine/{{ item.id }}"
        >

            <button class="btn-good">
                Release
            </button>

        </form>

        {% else %}

        -

        {% endif %}

    </td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</section>

{% endif %}


</div>

</body>

</html>
